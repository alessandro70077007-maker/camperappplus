# Python
__pycache__/
*.py[cod]
*.egg-info/

# Virtual env
.venv/
venv/
env/

# Dati locali (camper, viaggi, documenti, credenziali SMTP)
data/

# OS
.DS_Store
Thumbs.db

# Editor
.vscode/
.idea/
*.swp

# Streamlit
.streamlit/secrets.toml

# Edge app profile (creato dal launcher)
.edge_profile/

# Log runtime del launcher (rigenerato a ogni avvio)
launcher.log

# PyInstaller
build/
dist/
*.spec.bak

# Bundle ZIP copiato nella landing per test locale (artefatto)
# Il ZIP vero va su GitHub Releases, non nel repo
docs/*.zip

# QR del server mobile/run_qr.py (rigenerato a ogni avvio con IP corrente)
mobile/qr_telefono.png

# Lock file usato per sync cross-process tra desktop Streamlit e mobile Flet
data/.lock

# Windows Sandbox config personale (contiene path locale dell'autore)
test_in_sandbox.wsb
